  section AssessmentSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers AssessmentAnswer[]

  @@index([sectionId])
}

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  templateId     String
  propertyId     String
  inspectorId    String
  status         AssessmentStatus @default(DRAFT)
  scheduledFor   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  template  AssessmentTemplate @relation(fields: [templateId], references: [id])
  property  Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  inspector User               @relation("AssessmentInspector", fields: [inspectorId], references: [id])
  answers   AssessmentAnswer[]
