  @@index([templateId])
}

model AssessmentQuestion {
  id         String                 @id @default(cuid())
  sectionId  String
  prompt     String
  type       AssessmentQuestionType
  position   Int                    @default(0)
  isRequired Boolean                @default(false)
  options    Json                   @default("[]") // for SELECT / MULTI_SELECT
