// AI Property Intelligence Platform — core schema
// Property -> Evidence -> Asset -> Condition -> Issue -> History -> Cost -> Decision
//
// Tenant isolation rule: every org-owned row carries organizationId directly,
// OR is reachable only through a parent that carries organizationId. Server-side
// code must always resolve organizationId from the authenticated session/membership,
// never from client input. See src/lib/tenant.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PLATFORM_ADMIN
  OWNER
  PORTFOLIO_ADMIN
  REGIONAL_MANAGER
  FACILITIES_MANAGER
  INSPECTOR
  TECHNICIAN
  VENDOR
  VIEWER
}

enum AccessScopeType {
  PORTFOLIO
  REGION
  PROPERTY
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_DEVELOPMENT
  DIVESTED
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  REPLACED
  DECOMMISSIONED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
}

enum IssueSource {
  MANUAL
  ASSESSMENT
  DRONE
  MATTERPORT
  AI_SUGGESTED
  IMPORT
}

enum EvidenceType {
  PHOTO
  VIDEO
  DOCUMENT
  DRONE_IMAGE
  MATTERPORT_REFERENCE
  IMAGE_360
  MAP_REFERENCE
  POINT_CLOUD_REFERENCE
}

enum DocumentType {
  PDF
  CAD_REFERENCE
  BIM_REFERENCE
  WARRANTY
  INSPECTION_REPORT
  MANUAL
  PERMIT
  CONTRACT
  ROOF_REPORT
  FLOOR_PLAN
  OTHER
}

enum AssessmentQuestionType {
  YES_NO
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  CONDITION
  PHOTO
  VIDEO
  MEASUREMENT
  ASSET
  SIGNATURE
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

/// Lifecycle of a capture job. DRAFT is invisible to the vendor: a job being
/// assembled must not appear as work they owe. ACCEPTED and CANCELLED end the
/// vendor's access to the sites, which is why access is derived from this
/// status rather than from a standing grant someone has to remember to revoke.
enum CaptureJobStatus {
  DRAFT
  ISSUED
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CaptureJobSiteStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REJECTED
}

/// What a site owes before it can be submitted. CONDITION_SCORES is the one
/// that matters most: imagery alone never moves a property's health score,
/// because the score is computed from asset condition. A capture job that
/// does not ask for condition scores buys pictures and changes no number.
enum CaptureDeliverable {
  DRONE
  MATTERPORT
  IMAGE_360
  PHOTOS
  CONDITION_SCORES
}

enum ValidationStatus {
  AUTO_CALCULATED
  HUMAN_OBSERVED
  CUSTOMER_VERIFIED
  SPECIALIST_VERIFIED
  AI_SUGGESTED
  AI_HUMAN_VERIFIED
}

enum AIFindingStatus {
  SUGGESTED
  HUMAN_VERIFIED
  REJECTED
  SPECIALIST_VERIFIED
}

enum DroneCaptureStatus {
  CREATED
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum DroneOutputType {
  ORTHOMOSAIC
  POINT_CLOUD
  MESH_3D
  DSM
  DTM
  PHOTO_SET
}

enum NotificationType {
  ISSUE_CRITICAL
  ISSUE_ASSIGNED
  ASSESSMENT_DUE
  ASSESSMENT_OVERDUE
  PROCESSING_COMPLETED
  PROCESSING_FAILED
  REPORT_READY
  USER_INVITED
}

enum DataRetentionStatus {
  ACTIVE
  ARCHIVED
  SCHEDULED_FOR_DELETION
  DELETED
}

enum DeletionTargetType {
  PROPERTY
  ORGANIZATION
}

enum DeletionRequestStatus {
  PENDING
  CANCELLED
  BLOCKED_BY_LEGAL_HOLD
  COMPLETED
  FAILED
}

/**
 * The six surfaces spec §54 says a deletion must account for. Enumerated in
 * the schema rather than as loose strings so a new surface cannot be added
 * to the code without a migration making it visible.
 */
enum DeletionSurface {
  DATABASE
  OBJECT_STORAGE
  SEARCH_INDEX
  DERIVED_FILES
  CACHE
  BACKUP_RETENTION
}

enum DeletionSurfaceStatus {
  PENDING
  COMPLETED
  FAILED
  // Recorded, dated, and genuinely not yet done — used for backup
  // retention, where the data survives in backups until they expire.
  SCHEDULED
  // This deployment has no such surface. Stated explicitly rather than
  // reported as a success that never happened.
  NOT_APPLICABLE
}

enum LegalHoldScope {
  ORGANIZATION
  PROPERTY
}

/**
 * Idempotency (spec §65). IN_PROGRESS is claimed atomically by the unique
 * constraint before the handler runs, so a concurrent retry of the same key
 * is detected rather than executing twice.
 */
enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  // Attempt failed; nextAttemptAt is set and it will be retried.
  FAILED
  // Retries exhausted. Terminal — kept for the customer to inspect and replay.
  EXHAUSTED
}

enum SubscriptionComponentType {
  BASE_PLATFORM
  PROPERTY
  STORAGE
  AI
  PREMIUM_INTEGRATION
}

/**
 * What is being metered (spec §49).
 *
 * Storage is split per tier because the tiers are priced roughly an order of
 * magnitude apart — billing a deep-archived gigabyte at the standard rate
 * would overstate cost by ~20x, which is the whole point of having tiered it.
 *
 * AI is split into requests and tokens because both cost money on different
 * axes, and a provider that reports no token usage can still be metered
 * honestly as a request rather than recorded as zero tokens (i.e. as free).
 */
enum UsageMetricType {
  STORAGE_STANDARD_GB_MONTH
  STORAGE_IA_GB_MONTH
  STORAGE_ARCHIVE_GB_MONTH
  STORAGE_DEEP_ARCHIVE_GB_MONTH
  BANDWIDTH_GB
  PROCESSING_JOB
  AI_REQUEST
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  MATTERPORT_ALLOCATION
  /// One 360 panorama registered. Counted per image, not per byte: storage is
  /// already metered separately, and what a customer buys with a 360 plan is
  /// the right to capture panoramas, not the gigabytes they happen to occupy.
  IMAGE_360_CAPTURE
  GEOCODING_REQUEST
  DOCUMENT_INDEX_JOB
  REPORT_GENERATION
  DB_USAGE
}

enum ImportEntityType {
  PROPERTIES
  ASSETS
  ISSUES
  CONDITIONS
}

enum ImportStatus {
  UPLOADED
  PREVIEWED
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  // Spec §68 lists "Rollback" as an import requirement. A completed import
  // that turns out to be wrong is undone rather than deleted, so the record
  // of what happened survives the undo.
  ROLLED_BACK
}

enum ImportRowAction {
  CREATED
  UPDATED
  SKIPPED_DUPLICATE
  SKIPPED_ERROR
}

enum SavedViewEntity {
  PROPERTIES
  ASSETS
  ISSUES
}

// ---------------------------------------------------------------------------
// Identity / tenancy / RBAC
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  title           String?
  phone           String?
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Multi-factor authentication (spec §43). `mfaSecret` holds an AES-256-GCM
  // ciphertext, never the raw TOTP secret — see lib/mfa.ts. A secret may exist
  // while `mfaEnabledAt` is null: that is the pending-enrollment state, where
  // the user has scanned the code but not yet proven they can generate one.
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  mfaLastVerifiedAt DateTime?

  memberships            Membership[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  events                 Event[]                 @relation("EventActor")
  productEvents          ProductEvent[]          @relation("ProductEventActor")
  notifications          Notification[]
  savedViews             SavedView[]
  assignedIssues         Issue[]                 @relation("IssueAssignee")
  createdIssues          Issue[]                 @relation("IssueCreatedBy")
  resolvedIssues         Issue[]                 @relation("IssueResolvedBy")
  uploadedEvidence       Evidence[]              @relation("EvidenceUploadedBy")
  uploadedDocs           DocumentVersion[]       @relation("DocumentUploadedBy")
  conditionChanges       AssetConditionHistory[] @relation("ConditionChangedBy")
  assessmentsAsInspector Assessment[]            @relation("AssessmentInspector")
  aiQueryLogs            AIQueryLog[]
  issueComments          IssueComment[]          @relation("IssueCommentAuthor")
  exteriorMarkers        ExteriorMarker[]        @relation("ExteriorMarkerCreatedBy")
  mfaRecoveryCodes       MfaRecoveryCode[]
  createdCaptureJobs     CaptureJob[]            @relation("CaptureJobCreatedBy")
  reviewedCaptureSites   CaptureJobSite[]        @relation("CaptureJobSiteReviewedBy")
  impersonationSessions  ImpersonationSession[]  @relation("ImpersonationAdmin")
  legalHoldsPlaced       LegalHold[]             @relation("LegalHoldPlacedBy")
  deletionRequests       DeletionRequest[]       @relation("DeletionRequestedBy")
  webhookEndpoints       WebhookEndpoint[]       @relation("WebhookCreatedBy")

  @@index([email])
}

/**
 * A platform-support person viewing a customer's account (spec §45). The row
 * IS the authorization: `getSessionContext` looks one up on every request,
 * so revoking support access or letting the session expire takes effect
 * immediately rather than waiting for a token to be reissued.
 *
 * `reason` is required by the spec and enforced as non-trivial at the
 * service layer. `expiresAt` is what stops a forgotten session becoming
 * standing cross-tenant access.
 */
model ImpersonationSession {
  id             String    @id @default(cuid())
  adminUserId    String
  organizationId String
  reason         String
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  // "manual" | "expired" | "revoked_by_customer"
  endedReason    String?
  ipAddress      String?

  admin        User         @relation("ImpersonationAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([adminUserId, endedAt])
  @@index([organizationId, startedAt])
}

// One row per issued recovery code. Only the SHA-256 hash is stored, and a
// used code is retained (not deleted) so the audit trail can show that a
// specific code was consumed and when.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
}

// One row per (user, organization): defines the user's role within that org.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  // Only meaningful when role = VENDOR: ties this membership to the vendor
  // company record so vendor users only ever see work assigned to their company.
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  accessGrants AccessGrant[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Scoped access grants for roles that are not automatically org-wide
// (REGIONAL_MANAGER, FACILITIES_MANAGER, INSPECTOR, TECHNICIAN, VENDOR).
// Absence of any grant for a scoped role means zero property access (secure by default).
model AccessGrant {
  id           String          @id @default(cuid())
  membershipId String
  scopeType    AccessScopeType
  portfolioId  String?
  regionId     String?
  propertyId   String?
  createdAt    DateTime        @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  portfolio  Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  region     Region?    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([portfolioId])
  @@index([regionId])
  @@index([propertyId])
}

model Organization {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  retentionStatus DataRetentionStatus @default(ACTIVE)
  // Enterprise policy (spec §43): when true, every member of this org must
  // have MFA enrolled before they can use the app. Enforced server-side in
  // the app layout, not only in the UI.
  requireMfa      Boolean             @default(false)
  // Customer policy (spec §45): when false, platform support cannot start an
  // impersonation session against this organization at all, and any session
  // already running stops being honoured on the next request.
  allowSupportAccess Boolean          @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  memberships          Membership[]
  portfolios           Portfolio[]
  properties           Property[]
  issues               Issue[]
  assessmentTemplates  AssessmentTemplate[]
  evidence             Evidence[]
  documents            Document[]
  events               Event[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  featureFlagOverrides FeatureFlagOverride[]
  scoringWeights       ScoringCategoryWeight[]
  matterportConnection MatterportConnection?
  subscription         OrganizationSubscription?
  usageRecords         UsageRecord[]
  costRates            CostRate[]
  productEvents        ProductEvent[]
  onboardingProgress   OnboardingProgress?
  importJobs           ImportJob[]
  savedViews           SavedView[]
  aiQueryLogs          AIQueryLog[]
  exteriorMarkers      ExteriorMarker[]
  documentChunks       DocumentChunk[]
  impersonationSessions ImpersonationSession[]
  retentionPolicy      RetentionPolicy?
  idempotencyKeys      IdempotencyKey[]
  webhookEndpoints     WebhookEndpoint[]
  legalHolds           LegalHold[]
  deletionRequests     DeletionRequest[]
  storageTieringPolicy StorageTieringPolicy?
  storageObjects       StorageObject[]
  captureJobs          CaptureJob[]

  @@index([slug])
}

// ---------------------------------------------------------------------------
// Property graph: Organization -> Portfolio -> Region -> Property -> Site ->
// Building -> Floor -> Area -> System -> Asset
// ---------------------------------------------------------------------------

model Portfolio {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regions      Region[]
  properties   Property[]
  accessGrants AccessGrant[]

  @@index([organizationId])
}

model Region {
  id          String   @id @default(cuid())
  portfolioId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio    Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  properties   Property[]
  accessGrants AccessGrant[]

  @@index([portfolioId])
}

model Property {
  id                 String              @id @default(cuid())
  organizationId     String
  portfolioId        String
  regionId           String?
  name               String
  customerPropertyId String?
  externalIds        Json                @default("[]")
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  postalCode         String
  country            String              @default("US")
  latitude           Float?
  longitude          Float?
  propertyType       String              @default("Retail")
  squareFootage      Int?
  yearBuilt          Int?
  status             PropertyStatus      @default(ACTIVE)
  retentionStatus    DataRetentionStatus @default(ACTIVE)
  isDemoData         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  updatedBy          String?
  version            Int                 @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio    Portfolio    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  region       Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)

  buildings       Building[]
  assets          Asset[]
  issues          Issue[]
  assessments     Assessment[]
  evidence        Evidence[]
  documents       Document[]
  events          Event[]
  healthSnapshots PropertyHealthSnapshot[]
  matterportLinks MatterportPropertyLink[]
  droneCaptures   DroneCapture[]
  captureJobSites CaptureJobSite[]
  accessGrants    AccessGrant[]
  exteriorMarkers ExteriorMarker[]
  documentChunks  DocumentChunk[]
  legalHolds      LegalHold[]
  usageRecords    UsageRecord[]

  /**
   * Derived geography for spatial queries (§11). Prisma has no geography
   * type, so this is Unsupported: it is unreadable and unwritable through the
   * client, which is correct — it is a GENERATED column that Postgres
   * maintains from latitude/longitude, and nothing should ever write it.
   *
   * It is declared here despite being unusable because omitting it makes
   * `prisma migrate diff` emit a DROP COLUMN for it and a DROP INDEX for its
   * GiST index on the very next migration.
   *
   * Spatial reads therefore go through raw SQL — see src/lib/spatial.ts.
   */
  geo Unsupported("geography(Point, 4326)")?

  /**
   * Declared so `migrate diff` does not drop it. Without this line every
   * future migration emits DROP INDEX for it, and a radius search silently
   * degrades from an index lookup to a full table scan.
   */
  @@index([geo], type: Gist)

  @@unique([organizationId, customerPropertyId])
  @@index([organizationId])
  @@index([portfolioId])
  @@index([regionId])
  @@index([status])
}

model Building {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors   Floor[]
  assets   Asset[]
  issues   Issue[]

  @@index([propertyId])
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  name       String
  level      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  areas    Area[]
  assets   Asset[]

  @@index([buildingId])
}

model Area {
  id        String   @id @default(cuid())
  floorId   String
  name      String
  areaType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor  Floor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assets Asset[]
  issues Issue[]

  @@index([floorId])
}

model BuildingSystem {
  id        String   @id @default(cuid())
  name      String
  category  String // e.g. Roof, HVAC, Electrical, Plumbing, Fire/Life Safety, Interior, Exterior, Parking
  createdAt DateTime @default(now())

  assets Asset[]
}

model Asset {
  id             String  @id @default(cuid())
  organizationId String
  propertyId     String
  buildingId     String?
  floorId        String?
  areaId         String?
  systemId       String?

  name            String
  assetType       String
  customerAssetId String?
  externalIds     Json    @default("[]")
  manufacturer    String?
  model           String?
  serialNumber    String?

  installedAt             DateTime?
  expectedUsefulLifeYears Int?

  conditionScore   Float? // 0-100
  criticalityScore Int    @default(3) // 1=Low ... 5=Business Critical
  riskScore        Float?
  healthScore      Float?

  replacementCost    Int? // cents
  repairCostLifetime Int  @default(0) // cents

  status           AssetStatus      @default(ACTIVE)
  validationStatus ValidationStatus @default(AUTO_CALCULATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?
  version   Int      @default(1)

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building Building?       @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor    Floor?          @relation(fields: [floorId], references: [id], onDelete: SetNull)
  area     Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  system   BuildingSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  conditionHistory     AssetConditionHistory[]
  issues               Issue[]
  evidence             Evidence[]
  documents            Document[]
  assessmentAnswers    AssessmentAnswer[]
  matterportReferences MatterportReference[]
  exteriorMarkers      ExteriorMarker[]
  documentChunks       DocumentChunk[]

  @@unique([organizationId, customerAssetId])
  @@index([organizationId])
  @@index([propertyId])
  @@index([buildingId])
  @@index([assetType])
  @@index([criticalityScore])
}

// Append-only condition history. Never overwritten.
model AssetConditionHistory {
  id              String      @id @default(cuid())
  assetId         String
  previousScore   Float?
  newScore        Float
  changedAt       DateTime    @default(now())
  changedByUserId String?
  source          IssueSource @default(MANUAL)
  reason          String?
  evidenceId      String?

  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  changedBy User?     @relation("ConditionChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  evidence  Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([changedAt])
}

// ---------------------------------------------------------------------------
// Scoring engine
// ---------------------------------------------------------------------------

// organizationId null = platform default weight set.
model ScoringCategoryWeight {
  id             String   @id @default(cuid())
  organizationId String?
  category       String // Roof, HVAC, Electrical, Plumbing, FireLifeSafety, Interior, ExteriorParking, Issues
  weightPercent  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category])
}

model PropertyHealthSnapshot {
  id                        String   @id @default(cuid())
  propertyId                String
  healthScore               Float
  riskScore                 Float
  dataConfidenceScore       Float
  interiorScore             Float?
  exteriorScore             Float?
  categoryBreakdown         Json // { category: { score, weightPercent, contribution } }
  capitalExposure12mo       Int      @default(0) // cents
  capitalExposure24mo       Int      @default(0)
  capitalExposure36mo       Int      @default(0)
  capitalExposureByCategory Json     @default("{}")
  computedAt                DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, computedAt])
}

// ---------------------------------------------------------------------------
// Issues
// ---------------------------------------------------------------------------

model Issue {
  id             String  @id @default(cuid())
  organizationId String
  propertyId     String
  buildingId     String?
  areaId         String?
  assetId        String?

  title       String
  description String?
  severity    IssueSeverity @default(MEDIUM)
  status      IssueStatus   @default(OPEN)
  source      IssueSource   @default(MANUAL)

  assigneeId String?
  vendorId   String?

  estimatedCost Int? // cents
  actualCost    Int? // cents
  dueDate       DateTime?

  createdById  String
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building     Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  area         Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("IssueCreatedBy", fields: [createdById], references: [id])
  resolvedBy   User?        @relation("IssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  comments        IssueComment[]
  evidence        Evidence[]
  documents       Document[]
  exteriorMarkers ExteriorMarker[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([severity])
  @@index([assigneeId])
  @@index([vendorId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation("IssueCommentAuthor", fields: [authorId], references: [id])

  @@index([issueId])
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  trade          String?
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  issues      Issue[]
  memberships Membership[]
  captureJobs CaptureJob[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

model AssessmentTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     AssessmentSection[]
  assessments  Assessment[]

  @@index([organizationId])
}

model AssessmentSection {
  id         String @id @default(cuid())
  templateId String
  name       String
  position   Int    @default(0)

  template  AssessmentTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
