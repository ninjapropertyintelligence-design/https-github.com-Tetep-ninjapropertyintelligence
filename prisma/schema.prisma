// A user-placed pin on an exterior photo or orthomosaic, referencing the
// canonical Asset/Issue/Evidence record it points at — never a duplicate
// business object (spec: "No Duplicate Data Rule").
model ExteriorMarker {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  droneImageId   String?
  droneOutputId  String?
  assetId        String?
  issueId        String?
  evidenceId     String?
  label          String?
  xNormalized    Float // 0-1 position on the referenced image/orthomosaic
  yNormalized    Float
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
