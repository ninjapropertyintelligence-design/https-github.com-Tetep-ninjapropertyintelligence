  @@index([organizationId, createdAt])
  @@index([propertyId, createdAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Idempotency (spec §65) and outbound webhooks (spec §66)
// ---------------------------------------------------------------------------

/**
 * A client-supplied Idempotency-Key and the response it produced (spec §65:
 * "Repeated requests must not create duplicates").
 *
 * The key is unique per organization, NOT per endpoint: a key identifies one
 * logical operation, so reusing it on a different route or with a different
 * body is a client bug worth reporting rather than a second cache entry.
 * `requestHash` is what makes that detectable.
 */
model IdempotencyKey {
  id             String            @id @default(cuid())
  organizationId String
  userId         String?
  key            String
  method         String
  path           String
  /** SHA-256 of the request body — same key + different body is an error. */
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  /** Replay window. Past this, the key may be reused for a new operation. */
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([expiresAt])
}

/**
 * A customer-registered destination for event notifications (spec §66,
 * "prepares for CMMS integration").
 *
 * `secretEnc` is encrypted at rest through lib/crypto.ts — it is the signing
 * key the receiver uses to verify a delivery really came from us, so a
 * database dump must not hand an attacker the ability to forge deliveries.
 */
model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  description    String?
  secretEnc      String
  enabled        Boolean  @default(true)
  /** Event names this endpoint wants; empty array means every event. */
  eventTypes     Json     @default("[]")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  /** Reset on any success. Drives auto-disable of a dead endpoint. */
  consecutiveFailures Int @default(0)
  disabledReason String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("WebhookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@index([organizationId, enabled])
}

/**
 * One attempt-tracked delivery of one event to one endpoint.
 *
 * The row is created when the event fires and delivered out-of-band, so a
 * slow or unreachable customer endpoint can never slow down — or roll back —
 * the transaction that produced the event.
 *
 * Its `id` is sent as the delivery id header and is stable across retries,
 * which is what lets a receiver dedupe: spec §65 lists webhooks among the
 * operations that must be idempotent, and that is the receiver's half of it.
 */
model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  organizationId String
  eventId        String?
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  responseBody   String?
  error          String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String // e.g. "login", "property.updated", "export.created"
  entityType     String?
  entityId       String?
  metadata       Json     @default("{}")
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Data retention and secure deletion (spec §52, §54)
// ---------------------------------------------------------------------------

/**
 * Per-organization retention policy (spec §52). One field per category the
 * spec names, so "define policies for X" has a literal answer in the schema
 * rather than a value buried in code. Days, not booleans: every one of these
 * is a duration question.
 */
model RetentionPolicy {
  id             String @id @default(cuid())
  organizationId String @unique

  // "Active property" — how long condition history, captures and evidence
  // are kept for a property still in service. Null = keep indefinitely,
  // which is the correct default for an asset-condition record of truth.
  activePropertyRetentionDays  Int?
  // "Deleted property" — grace window between requesting deletion and the
  // data actually being destroyed, so a mistake is recoverable.
  deletedPropertyGraceDays     Int @default(30)
  // "Deleted organization"
  deletedOrganizationGraceDays Int @default(30)
  // "Archived capture" — older captures superseded by a newer one.
  archivedCaptureRetentionDays Int @default(365)
  // "Customer termination" — how long after a contract ends the data is
  // retained so the customer can still export it (spec §53).
  customerTerminationGraceDays Int @default(30)
  // "Backup expiration" — how long deleted data survives in backups. This
  // is what makes the backup surface of a deletion honest: it cannot be
  // erased on request, only aged out, and this says by when.
  backupRetentionDays          Int @default(35)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * Legal hold (spec §52). While one is active, deletion of anything in scope
 * is refused — retention policy does not override a hold, which is the whole
 * point of having one.
 */
model LegalHold {
  id             String         @id @default(cuid())
  organizationId String
  scopeType      LegalHoldScope
  propertyId     String?
  reason         String
  placedByUserId String?
  placedAt       DateTime       @default(now())
  releasedAt     DateTime?
  releasedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  placedBy     User?        @relation("LegalHoldPlacedBy", fields: [placedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, releasedAt])
  @@index([propertyId])
}

/**
 * A request to destroy data, and the record of what actually happened to
 * each surface (spec §54: "Delete does not mean hiding a row"). The
 * per-surface breakdown is the deliverable — a single "deleted: true" flag
 * would be exactly the claim the spec warns against.
 */
model DeletionRequest {
  id                String                @id @default(cuid())
  organizationId    String
  targetType        DeletionTargetType
  targetId          String
  // Kept denormalised: after execution the target row is gone, and an audit
  // record that can no longer say what was deleted is not much of a record.
  targetLabel       String
  reason            String
  requestedByUserId String?
  requestedAt       DateTime              @default(now())
  scheduledFor      DateTime
  status            DeletionRequestStatus @default(PENDING)
  executedAt        DateTime?
  cancelledAt       DateTime?
  error             String?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?                   @relation("DeletionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  surfaces     DeletionSurfaceResult[]

  @@index([organizationId, status])
  @@index([status, scheduledFor])
}

model DeletionSurfaceResult {
  id          String                @id @default(cuid())
  requestId   String
  surface     DeletionSurface
  status      DeletionSurfaceStatus @default(PENDING)
  // How many objects/rows this surface accounted for.
  itemCount   Int                   @default(0)
  // Why, when the status is not COMPLETED — e.g. which backups still hold
  // the data and until when.
  detail      String?
  completedAt DateTime?

  request DeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, surface])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String?
  link           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
}

model FeatureFlag {
  key            String   @id
  description    String
  defaultEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())

  overrides FeatureFlagOverride[]
}

model FeatureFlagOverride {
  id             String   @id @default(cuid())
  flagKey        String
  organizationId String
  enabled        Boolean
  updatedAt      DateTime @updatedAt

  flag         FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flagKey, organizationId])
}

model SavedView {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  name           String
  entity         SavedViewEntity
  filters        Json            @default("{}")
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}

// ---------------------------------------------------------------------------
// Billing (software subscription, separate from capture-service revenue)
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                 String   @id @default(cuid())
  key                String   @unique // founding_partner | portfolio | enterprise
  name               String
  priceMonthlyCents  Int? // null = custom / contact us (Enterprise)
  includedProperties Int
  includedUsers      Int
  includedStorageGB  Int
  includedAIUsage    Int // arbitrary AI credit units per month
  hasSSO             Boolean  @default(false)
  hasAPI             Boolean  @default(false)
  hasAdvancedReports Boolean  @default(false)
  hasAdvancedAI      Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  subscriptions OrganizationSubscription[]
}

model OrganizationSubscription {
  id                 String    @id @default(cuid())
  organizationId     String    @unique
  planId             String
  status             String    @default("active") // active | trialing | past_due | canceled
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])
  items        SubscriptionItem[]

  @@index([planId])
}

model SubscriptionItem {
  id             String                    @id @default(cuid())
  subscriptionId String
  componentType  SubscriptionComponentType
  quantity       Int                       @default(1)
  unitPriceCents Int                       @default(0)

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

/**
 * One metered unit of consumption (spec §49).
 *
 * Deliberately stores QUANTITY ONLY, never a cost. Cost is derived at report
 * time from the CostRate that was in effect at `recordedAt`. Denormalising a
 * cost here would freeze every historical row against whatever rate happened
 * to be configured on the day it was written, so correcting a mistyped rate
 * could never be applied to the periods it corrupted. This is internal
 * cost-to-serve, not a customer invoice that has to stay frozen once issued.
 *
 * `propertyId` is null when the consumption genuinely belongs to no single
 * property (an org-wide AI question, a platform job). That null is meaningful
 * and must survive into the report as unattributed overhead rather than being
 * quietly spread across properties — see summarizePropertyCogs.
 */
model UsageRecord {
  id             String          @id @default(cuid())
  organizationId String
  propertyId     String?
  metricType     UsageMetricType
  quantity       Float
  /** Which subsystem recorded this, for tracing a surprising number back. */
  source         String?
  recordedAt     DateTime        @default(now())
  metadata       Json            @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId, metricType, recordedAt])
  @@index([organizationId, propertyId, recordedAt])
  @@index([organizationId, recordedAt])
}

/**
 * A versioned unit cost (spec §50).
 *
 * Rates are versioned by effective window rather than mutated in place: a
 * report for last month must price last month's usage at last month's rate.
 * Editing a rate row in place would silently rewrite history.
 *
 * `organizationId` null is the platform default; an organization-specific row
 * overrides it for that organization only.
 *
 * Costs are in MICROS (millionths of a currency unit), not cents, because
 * per-token AI costs are several orders of magnitude below a cent — at cent
 * precision every token rounds to zero and the entire AI line reads as free.
 */
model CostRate {
  id             String          @id @default(cuid())
  organizationId String?
  metricType     UsageMetricType
  unitCostMicros Int
  currency       String          @default("USD")
  effectiveFrom  DateTime
  /** Null means "still in effect". */
  effectiveTo    DateTime?
  note           String?
  createdAt      DateTime        @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metricType, effectiveFrom])
  @@index([metricType, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Product analytics (spec §105)
// ---------------------------------------------------------------------------

/**
 * A product-usage event: someone used a feature.
 *
 * THIS IS A THIRD THING, deliberately separate from the two event streams
 * that already exist, because conflating them breaks all three:
 *
 *  - `Event` records business facts about the portfolio ("issue.created").
 *    It is domain data a customer can act on, and it is not emitted when
 *    someone merely *looks* at something — which is most of what product
 *    analytics is about.
 *  - `AuditLog` is a compliance record of sensitive actions, with IP
 *    addresses. It answers "who did this" under scrutiny. Product analytics
 *    is high-volume and disposable; letting it share that table would drown
 *    the audit trail and force one retention policy onto two things that
 *    need different ones.
 *
 * `impersonated` is the field that keeps these numbers honest. Platform
 * support can view a customer's account (§45), and while impersonating,
 * `ctx.organizationId` is the CUSTOMER's — so without this flag our own
 * staff's clicks would be indistinguishable from customer engagement and
 * would inflate every adoption and active-user figure we report.
 *
 * `metadata` is for low-cardinality dimensions only (a step number, a tab
 * name). No free text and no PII: this table must not quietly become a
 * second copy of the customer's data with a weaker retention policy.
 */
model ProductEvent {
  id             String   @id @default(cuid())
  organizationId String
  /** Null for system-triggered activity that no user performed. */
  userId         String?
  /** A key from the closed vocabulary in src/lib/analytics.ts, not free text. */
  feature        String
  /** True when platform support performed this while impersonating (§45). */
  impersonated   Boolean  @default(false)
  role           Role?
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("ProductEventActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, feature, occurredAt])
  @@index([userId, occurredAt])
  @@index([feature, occurredAt])
}

// ---------------------------------------------------------------------------
// Onboarding
// ---------------------------------------------------------------------------

model OnboardingProgress {
  organizationId      String   @id
  organizationSetup   Boolean  @default(true)
  usersInvited        Boolean  @default(false)
  propertiesImported  Boolean  @default(false)
  assetsImported      Boolean  @default(false)
  interiorConnected   Boolean  @default(false)
  exteriorConnected   Boolean  @default(false)
  firstAssessmentDone Boolean  @default(false)
  aiReady             Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Import / dedup
// ---------------------------------------------------------------------------

model ImportJob {
  id               String           @id @default(cuid())
  organizationId   String
  entityType       ImportEntityType
  status           ImportStatus     @default(UPLOADED)
  originalFilename String
  storageKey       String
  columnMapping    Json             @default("{}")
  rowCount         Int              @default(0)
  successCount     Int              @default(0)
  errorCount       Int              @default(0)
  // Rows matched to something that already exists (spec §69). Counted
  // separately from errors: a duplicate is a normal outcome, not a failure.
  duplicateCount   Int              @default(0)
  errorReportKey   String?
  // Properties are created inside a portfolio, so an import has to be told
  // which one unless every row names its own.
  targetPortfolioId String?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?
  undoneAt         DateTime?
  errorMessage     String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rowResults   ImportRowResult[]

  @@index([organizationId])
  @@index([status])
}

/**
 * What happened to each row, and enough information to undo it (spec §68
 * "Rollback"). `beforeImage` holds the previous values of exactly the fields
 * an update changed — storing the whole record would make an undo overwrite
 * edits made after the import, which is a different kind of data loss.
 */
model ImportRowResult {
  id          String          @id @default(cuid())
  importJobId String
  /** 1-based data row in the source file, so an error report matches what the user sees. */
  rowNumber   Int
  action      ImportRowAction
  entityId    String?
  beforeImage Json?
  message     String?
  createdAt   DateTime        @default(now())

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([importJobId, action])
}

// ---------------------------------------------------------------------------
// Storage lifecycle tiering (spec §51)
// ---------------------------------------------------------------------------

/**
 * Where an object currently lives. These map onto S3 storage classes, but the
 * names are deliberately ours: not every backing store has all of them, and
 * some (Supabase Storage, Cloudflare R2) have none at all. The provider
 * reports what it supports and the runner records what actually happened —
 * never what was intended.
 */
enum StorageTier {
  STANDARD
  INFREQUENT_ACCESS
  ARCHIVE
  DEEP_ARCHIVE
}

/**
 * Which kind of record owns an object. The tier ledger is deliberately
 * uniform across object kinds rather than a `tier` column bolted onto each of
 * DroneImage/DroneOutput/DocumentVersion/Evidence, because cost reporting
 * (§49/§50) wants one table to sum, not a four-way union.
 */
enum StorageObjectKind {
  DRONE_IMAGE
  DRONE_OUTPUT
  DOCUMENT_VERSION
  EVIDENCE
}

/** An archived object cannot be read until it is restored, and restore is asynchronous. */
enum StorageRestoreState {
  NOT_REQUESTED
  IN_PROGRESS
  AVAILABLE
  FAILED
}

model StorageTieringPolicy {
  id             String @id @default(cuid())
  organizationId String @unique

  // Off by default. Tiering changes read semantics for archived objects, so
  // it is opt-in rather than something a customer discovers after the fact.
  enabled Boolean @default(false)

  // Age in days after which an object becomes eligible for each tier. Null
  // means "never move it there", which is why these are nullable rather than
  // sentinel zeroes.
  infrequentAccessAfterDays Int? @default(90)
  archiveAfterDays          Int? @default(365)
  deepArchiveAfterDays      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * The tier ledger: one row per stored object, recording where it actually is.
 *
 * `sizeBytes` is copied here rather than joined. That is not duplicated
 * business data — stored objects are immutable once written, so this is a
 * point-in-time record of what was transitioned, and it is what makes a
 * cost-by-tier rollup a single indexed scan instead of a four-table union.
 */
model StorageObject {
  id             String            @id @default(cuid())
  organizationId String
  storageKey     String
  kind           StorageObjectKind
  /** BigInt: a 32-bit Int caps a single object at 2.147 GB, which drone point clouds and orthomosaics routinely exceed. */
  sizeBytes      BigInt?

  currentTier        StorageTier @default(STANDARD)
  // When the underlying object was created, which is what age is measured
  // from — not when this ledger row was written, since backfilled rows would
  // otherwise all look brand new and never become eligible.
  objectCreatedAt    DateTime
  lastTransitionedAt DateTime?

  restoreState       StorageRestoreState @default(NOT_REQUESTED)
  restoreRequestedAt DateTime?
  restoreExpiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storageKey])
  @@index([organizationId, currentTier])
  // Drives the "what is due for transition" scan.
  @@index([organizationId, objectCreatedAt])
}

// ---------------------------------------------------------------------------
// Capture jobs
// ---------------------------------------------------------------------------

/// Work ordered from a capture subcontractor: go to these sites, produce these
/// deliverables, by this date.
///
/// This model is also the subcontractor's AUTHORIZATION. A vendor has no
/// property access of its own — `propertyScopeWhere` grants access to exactly
/// the sites on their open jobs, so access begins when the job is issued and
/// ends when it is accepted or cancelled. Nobody has to remember to revoke a
/// grant, which is the failure mode of handing contractors standing accounts.
model CaptureJob {
  id             String           @id @default(cuid())
  organizationId String
  /// Null while a job is being drafted before a vendor is chosen.
  vendorId       String?
  title          String
  instructions   String?
  status         CaptureJobStatus @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime?
  submittedAt    DateTime?
  closedAt       DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("CaptureJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sites        CaptureJobSite[]

  @@index([organizationId, status])
  @@index([vendorId, status])
}

/// One property on a capture job, with its own status so a 40-site job can be
/// delivered and reviewed site by site rather than all-or-nothing.
model CaptureJobSite {
  id              String               @id @default(cuid())
  jobId           String
  propertyId      String
  deliverables    CaptureDeliverable[]
  status          CaptureJobSiteStatus @default(PENDING)
  notes           String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  job        CaptureJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("CaptureJobSiteReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// A site appears on a job once. Two rows would let one submission satisfy
  /// the other and make the completion count wrong.
  @@unique([jobId, propertyId])
  @@index([propertyId])
}
