  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([inspectorId])
}

model AssessmentAnswer {
  id             String   @id @default(cuid())
  assessmentId   String
  questionId     String
  assetId        String?
  textValue      String?
  numberValue    Float?
  boolValue      Boolean?
  conditionValue Float? // 0-100 for CONDITION type
  selectValues   Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])
  asset      Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  evidence   Evidence[]

  @@unique([assessmentId, questionId, assetId])
  @@index([assessmentId])
}

// ---------------------------------------------------------------------------
// Evidence (common capture model)
// ---------------------------------------------------------------------------

model Evidence {
  id                 String  @id @default(cuid())
  organizationId     String
  propertyId         String?
  assetId            String?
  issueId            String?
  assessmentId       String?
  assessmentAnswerId String?

  type         EvidenceType
  source       IssueSource  @default(MANUAL)
  captureDate  DateTime?
  uploadedById String
  latitude     Float?
  longitude    Float?

  storageKey   String
  thumbnailKey String?
  mimeType     String?
  /** BigInt: a 32-bit Int caps a single object at 2.147 GB, which drone point clouds and orthomosaics routinely exceed. */
  sizeBytes    BigInt?
  metadata     Json    @default("{}")

  createdAt DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property         Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  asset            Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
