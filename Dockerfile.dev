# Local demo image (not for production deployment — see Vercel for that).
#
# Runs the app in dev mode so the container needs no build-time database:
# `next build` evaluates route modules, and while the Prisma client is now
# constructed lazily, dev mode keeps the startup path simple and the feedback
# loop fast for someone poking at the demo.
FROM node:22-bookworm-slim

# openssl: required by Prisma's query engine.
# postgresql-client: gives the entrypoint `pg_isready` to wait on the database.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl postgresql-client ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first, so editing source does not reinstall node_modules.
# postinstall runs `prisma generate`, which needs the schema present.
COPY package*.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci

COPY . .

EXPOSE 3000
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
