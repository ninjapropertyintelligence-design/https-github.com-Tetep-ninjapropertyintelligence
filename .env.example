DATABASE_URL="postgresql://user:password@localhost:5432/property_intel?schema=public"
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/property_intel_test?schema=public"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Object storage (S3-compatible) - not configured in dev; local storage adapter used instead
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
# Mapbox (optional - map degrades gracefully without it).
# NEXT_PUBLIC_MAPBOX_TOKEN is exposed to the browser and drives the
# Portfolio Map. MAPBOX_TOKEN is server-only and is used for address
# geocoding on property create; it falls back to the public token when
# unset, but a dedicated server token keeps geocoding quota off a token
# anyone can read out of the browser bundle. Without either, properties
# save fine and simply have no coordinates until one is supplied.
NEXT_PUBLIC_MAPBOX_TOKEN=""
MAPBOX_TOKEN=""
# AI provider selection: "anthropic" | "openai" | "none" (default "anthropic")
AI_PROVIDER="anthropic"
# Anthropic API key for the AI tool gateway (optional - AI pages degrade
# gracefully with an honest "not configured" message without it)
ANTHROPIC_API_KEY=""
# OpenAI API key — only used when AI_PROVIDER="openai"
OPENAI_API_KEY=""

# Matterport integration (optional - Interior tab shows a clean
# NOT_CONFIGURED state without these). Enterprise/partner Model API
# credentials + an embed SDK key for the interactive viewer.
MATTERPORT_API_TOKEN=""
MATTERPORT_API_SECRET=""
MATTERPORT_SDK_KEY=""
# Override only if Matterport's Model API endpoint changes:
# MATTERPORT_API_BASE_URL="https://api.matterport.com/api/models/graph"

# Key used to encrypt stored third-party integration credentials at rest
# (falls back to NEXTAUTH_SECRET if unset — set a dedicated key in production)
INTEGRATION_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"
